# Database Configuration
DB_HOST=localhost
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=horiserverlive
DB_PORT=3306

# Database Connection Pool Configuration (for concurrent user scaling)
# For 50+ concurrent users, use: DB_POOL_LIMIT=100, DB_QUEUE_LIMIT=200
DB_POOL_LIMIT=100
DB_QUEUE_LIMIT=200

# Session Configuration
SESSION_TIMEOUT_MINUTES=30

# Admin Authentication
ADMIN_USERNAME=BSI
ADMIN_PASSWORD_HASH=$2b$10$qDH7bN/lOUxoESYtFmmFG.zfnPR8YaBTyVxIVSaMw5x5zTW/l6eRq00

# Server Configuration
PORT=5000

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3010,http://your-ip:3010

# Email Configuration
SMTP_HOST=your-smtp-host.example.com
SMTP_PORT=587
SMTP_SECURE=false  # true for port 465, false for other ports
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
DEFAULT_FROM_EMAIL=your-email@example.com  # Should match SMTP_USER

# Environment
NODE_ENV=development  # development or production

# Phase 1-5 Performance Optimization Configuration

# Phase 1: Database Cleanup (CleanupManager)
# Batch cleanup settings for telemetry data
CLEANUP_BATCH_SIZE=5000
CLEANUP_INTERVAL_SECONDS=60
CLEANUP_RETENTION_DAYS_METRICS=30
CLEANUP_RETENTION_DAYS_SLOW_QUERIES=7
CLEANUP_RETENTION_DAYS_LOGS=14

# Phase 2: Query Optimization (MetricQueryOptimizer)
# Caching configuration for metric queries
CACHE_TTL_METRICS_SECONDS=300
CACHE_TTL_AGGREGATION_SECONDS=600
CACHE_TTL_LATEST_SECONDS=60

# Phase 3: Connection Pool Monitoring (PoolMonitor)
# Pool health check configuration
POOL_CHECK_INTERVAL_SECONDS=30
POOL_WARNING_THRESHOLD=0.6
POOL_ALERT_THRESHOLD=0.8

# Phase 4: Bulk Insert Optimization (BulkInsertManager)
# Batch metric write configuration
BULK_INSERT_BATCH_SIZE=500
BULK_INSERT_FLUSH_INTERVAL_SECONDS=5
BULK_INSERT_MAX_RETRIES=3

# Phase 5: Performance Monitoring (PerformanceMetrics)
# Performance metrics tracking
SLOW_QUERY_THRESHOLD_SECONDS=1
HEALTH_CHECK_INTERVAL_SECONDS=60